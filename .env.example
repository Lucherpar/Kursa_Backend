# Base de datos (Render PostgreSQL)
DATABASE_URL=postgresql://kursa_user:password@kursa-db.xxx.render.com/kursa?sslmode=require

# JWT
JWT_SECRET=tu_secreto_muy_seguro_cambiar_en_produccion
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=otro_secreto_para_refresh_tokens
REFRESH_TOKEN_EXPIRES_IN=30d

# Servidor
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Archivos
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/uploads

# Socket.IO
SOCKET_ORIGIN=http://localhost:5173
