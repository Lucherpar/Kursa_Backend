# Base de datos (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=cambiar_por_valor_seguro_aleatorio
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=cambiar_por_valor_seguro_aleatorio
REFRESH_TOKEN_EXPIRES_IN=30d

# Servidor
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Archivos
MAX_FILE_SIZE=10485760

# Socket.IO
SOCKET_ORIGIN=http://localhost:5173
