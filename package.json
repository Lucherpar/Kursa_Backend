  "description": "Plataforma educativa tipo Aules - Backend Node.js + TypeScript + PostgreSQL (Neon)",
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/src/app.js",
